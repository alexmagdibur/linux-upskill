# Скопируйте в .env: cp .env.example .env  (файл .env не коммитится)
ENV=dev                       # dev | test | prod

# --- хранилища ---
DATABASE_URL=postgresql+asyncpg://upskill:upskill@127.0.0.1:15432/upskill
REDIS_URL=redis://127.0.0.1:6379/0
POSTGRES_PASSWORD=upskill

# --- безопасность ---
APP_SECRET=dev-only-secret-change-me-0123456789abcdef   # в prod: >= 32 случайных символов
INTERNAL_TOKEN=dev-internal-token-change-me             # общий секрет API <-> worker (в prod обязателен)
PUBLIC_ORIGIN=http://localhost:5173                     # единственный разрешённый Origin для CSRF/WebSocket
COOKIE_SECURE=false                                     # в prod true (HTTPS/WSS)
TRUST_PROXY=false

# --- sandbox ---
SANDBOX_RUNTIME=docker                # docker | disabled (disabled = песочницы выключены, API отвечает 503)
SANDBOX_MAX_CONCURRENT=10
SANDBOX_TTL_SECONDS=1800
SANDBOX_IDLE_SECONDS=600
SANDBOX_CPU_LIMIT=0.5
SANDBOX_MEMORY_LIMIT=256m

# --- сервисы ---
WORKER_URL=http://127.0.0.1:8100        # где API видит worker
API_INTERNAL_URL=http://127.0.0.1:8000  # где worker видит API

# --- лимиты запросов (Redis) ---
RATE_LIMIT_ENABLED=true   # регистрация: 10/час с IP. Для многократных прогонов e2e/нагрузки локально: false или `redis-cli --scan --pattern 'rl:*' | xargs redis-cli del`
